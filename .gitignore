.DS_Store
# dist/ is committed on purpose: VentraIP shared hosting has no Node, so the
# server can't build. cPanel Git Version Control pulls the repo and .cpanel.yml
# copies dist/ into the docroot. Always commit a fresh `npm run build` output.
# Runtime cache the proxy writes next to itself — never commit it.
dist/api/cache/
# Dev-only last-good-cache for the charts middleware (mirrors charts.php).
.cache/
