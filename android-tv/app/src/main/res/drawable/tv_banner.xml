<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320x180dp). Dark plate, the Depth logo
     centred, with the brand's green accent bar along the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scoreboard_bg" />
        </shape>
    </item>

    <item
        android:height="4dp"
        android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <solid android:color="@color/scoreboard_green" />
        </shape>
    </item>

    <item
        android:bottom="46dp"
        android:left="60dp"
        android:right="60dp"
        android:top="46dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/depth_logo"
            android:tint="#FFFFFF" />
    </item>
</layer-list>
