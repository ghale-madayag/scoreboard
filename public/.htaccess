# Depth Scoreboard — static SPA + PHP proxy
Options -Indexes

<IfModule mod_headers.c>
  # index.html is the ONLY file with a stable name, and it names the hashed
  # asset files. If the TV caches it, it stays pinned to an old build forever
  # and no redeploy is ever picked up — so this must never be cached.
  # (Guarded: an unguarded Header directive is a fatal config error on a host
  # without mod_headers, not a silent no-op.)
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  # Everything Vite emits into assets/ carries a content hash in its filename,
  # so any change produces a NEW url. These can be cached hard and forever.
  # Images are included deliberately: the author portraits and the logo are
  # hashed exactly like the js/css, and without them listed here they were the
  # only build output being revalidated on every page load.
  <FilesMatch "\.(js|css|woff2?|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fallback for hosts without mod_headers, so caching still behaves.
<IfModule !mod_headers.c>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                 "access plus 1 year"
    ExpiresByType text/html        "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
  </IfModule>
</IfModule>

# Compression. The main bundle is 256 KB raw but 86 KB gzipped, and the TV is on
# a flaky link where that difference is most of the boot time.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    # text/javascript AND application/javascript: Apache 2.4 serves .js as
    # text/javascript, so listing only the application/* form silently leaves
    # the largest file on the board uncompressed (verified — it did).
    AddOutputFilterByType DEFLATE text/html text/css text/plain \
      text/javascript application/javascript application/json image/svg+xml
  </IfModule>
  # woff2 is already compressed — re-compressing wastes CPU and can grow it.
  SetEnvIfNoCase Request_URI \.woff2$ no-gzip dont-vary
</IfModule>

# Make sure the self-hosted fonts are served with the right type rather than
# being sniffed.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
